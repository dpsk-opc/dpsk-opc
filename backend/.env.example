# DPSK-OPC Backend

# ============ Server ============
HOST=0.0.0.0
PORT=8000

# ============ Message Bus ============
# Supported backends: memory, redis, kafka
MESSAGE_BUS_BACKEND=memory
# MESSAGE_BUS_BACKEND=redis
# MESSAGE_BUS_BACKEND=kafka

# Redis (used when MESSAGE_BUS_BACKEND=redis)
REDIS_URL=redis://localhost:6379
REDIS_STREAM_MAX_LEN=10000

# Kafka (used when MESSAGE_BUS_BACKEND=kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dpskopc

# Timeouts
REQUEST_TIMEOUT_SECS=30
GROUP_TASK_TIMEOUT_SECS=60

# ============ LLM Configuration ============
# LLM Provider: openai, azure, local, etc.
LLM_PROVIDER=openai

# Default model (can be overridden per agent)
LLM_MODEL=gpt-3.5-turbo

# API Key (required for OpenAI-compatible APIs)
LLM_API_KEY=your-api-key-here

# Base URL (optional, for proxies or Azure OpenAI)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=https://your-azure.openai.azure.com

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# ============ Agent Configuration ============
# Agent definitions directory
AGENTS_ROOT=~/.dpskopc/agents

# Skills directory
SKILLS_ROOT=~/.dpskopc/skills

# Default agent for chat requests
DEFAULT_AGENT_ID=秘书

# Agent execution settings
AGENT_TASK_TIMEOUT_SECS=300
MAX_INSTANCES_PER_AGENT=5

# ============ Logging ============
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============ Database ============
DATABASE_URL=sqlite:///./dpsk_opc.db

# ============ Observability ============
PROMETHEUS_PORT=9090
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

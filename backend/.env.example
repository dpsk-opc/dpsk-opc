# DPSK-OPC Backend

# Server
HOST=0.0.0.0
PORT=8000

# Message Bus
MESSAGE_BUS_BACKEND=memory
# MESSAGE_BUS_BACKEND=redis
# MESSAGE_BUS_BACKEND=kafka

# Redis
REDIS_URL=redis://localhost:6379
REDIS_STREAM_MAX_LEN=10000

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dpskopc

# Timeouts
REQUEST_TIMEOUT_SECS=30
GROUP_TASK_TIMEOUT_SECS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Observability
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
